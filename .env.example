# ==============================================================================
# Database Configuration
# ==============================================================================
POSTGRES_PORT=5433
DATABASE_URL="postgresql://username:password@localhost:5433/dbname?schema=public"

# ==============================================================================
# NextAuth / Authentication
# ==============================================================================
# The canonical URL of your site (e.g., https://your-domain.com in production)
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt session data.
# Generate one using: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your_generated_secret_here"
NEXTAUTH_SECRET="your_generated_secret_here"

# ------------------------------------------------------------------------------
# OAuth Providers (Optional: Required if using GitHub or Google login)
# ------------------------------------------------------------------------------
GITHUB_ID="your_github_client_id"
GITHUB_SECRET="your_github_client_secret"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ==============================================================================
# External APIs
# ==============================================================================
# The URL for the backend prediction API (Home Credit Server endpoint)
NEXT_PUBLIC_PREDICTION_API_URL="http://127.0.0.1:8000/predict"
